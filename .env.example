# 이 파일을 .env 로 복사해서 쓴다. (.env 는 git 에 올라가지 않는다)

# DB 주소
# 로컬: SQLite 파일
DATABASE_URL="file:./dev.db"
# 배포: Turso 주소와 토큰 (README "배포" 참고)
# DATABASE_URL="libsql://<db이름>-<계정>.turso.io"
# DATABASE_AUTH_TOKEN="<토큰>"

# 내 신청 조회 쿠키를 서명하는 비밀 값. 배포에서는 꼭 16자 이상의 임의 문자열로 바꾼다.
SESSION_SECRET="change-this-to-a-long-random-string"

# 사진 업로드 저장소 (배포 전용). Vercel 프로젝트에 Blob 저장소를 연결하면 자동으로 생긴다.
# BLOB_READ_WRITE_TOKEN=""
